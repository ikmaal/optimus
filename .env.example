# PostgreSQL — local dev (see docker-compose.yml) or Render `connectionString`
DATABASE_URL="postgresql://optimus:optimus@localhost:5432/optimus?schema=public"

# Slack daily digest — pick ONE approach:
# A) Incoming Webhook or Workflow trigger URL (paste from Slack)
# SLACK_WEBHOOK_URL="https://hooks.slack.com/services/XXX/YYY/ZZZ"
#    or Workflow: https://hooks.slack.com/triggers/...
# If using Workflow triggers: add a Text field in the webhook step named e.g. "Digest" (JSON key often `digest`)
# and set the same key here if Slack shows something different:
# SLACK_WORKFLOW_MESSAGE_KEY="digest"

# B) Bot API (alternative)
# SLACK_BOT_TOKEN="xoxb-..."
# SLACK_CHANNEL_ID="C01234567"

# Optional: for `npm run digest:trigger` against a deployed app (default: http://localhost:3000)
# DIGEST_BASE_URL="https://cars.example.com"

# Protect GET /api/cron/daily-digest (Authorization: Bearer <this value>)
# CRON_SECRET="generate-a-long-random-string"

# AI check-in capture (odometer + fuel) — all three required to enable scanning.
# Without them, scanning is disabled (dev can skip; production returns 501).
# OpenAI key used server-side by /api/cars/:id/inspection/scan (GPT-4o vision).
# OPENAI_API_KEY="sk-..."
# Supabase project URL, e.g. https://xxxx.supabase.co
# SUPABASE_URL="https://xxxx.supabase.co"
# Supabase service role key (server-only secret — never expose to the client).
# SUPABASE_SERVICE_ROLE_KEY="eyJ..."
# Private Storage bucket for inspection photos (optional, default: car-inspections).
# Create it in Supabase: Storage → New bucket → name "car-inspections", keep it private.
# SUPABASE_INSPECTION_BUCKET="car-inspections"

# Mapbox satellite background on the carpark map (client-side — use NEXT_PUBLIC_ prefix).
# Get a free token at https://account.mapbox.com/access-tokens/
# NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN="pk...."
